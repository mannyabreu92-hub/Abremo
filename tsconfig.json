{
  // Type-checks the plain JavaScript (no TypeScript files, no build step): `npm run typecheck`.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/core/**/*.js", "src/ui/**/*.js", "scripts/gen-seed-sql.js", "scripts/gen-sw.js", "scripts/write-config.js"],
  // app.js joins the check as it is split into views (src/ui/views/); most of what remains there is DOM typing.
  "exclude": ["src/vendor/**", "src/ui/app.js", "node_modules"]
}
